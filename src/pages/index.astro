---
import Base from '../layouts/Base.astro';
import PubEntry from '../components/PubEntry.astro';
import PersonCard from '../components/PersonCard.astro';
import NewsList from '../components/NewsList.astro';
import { copy, publications, people, news } from '../lib/data';
---
<Base title="Home">
  <section class="hero"><p class="eyebrow">{copy.lab.name}</p><h1>{copy.lab.tagline}</h1><p class="intro">{copy.lab.intro}</p><ul class="theme-links">{copy.themes.map((theme, i) => <li><span class="index" aria-hidden="true">0{i+1}</span><a href={`/research/#${theme.id}`}>{theme.bullet}<span aria-hidden="true">↗</span></a></li>)}</ul></section>
  <section class="home-section"><div class="section-heading"><h2>Selected publications</h2><a href="/publications/">All publications →</a></div>{publications.filter(p => p.selected).map(paper => <PubEntry paper={paper} />)}<p class="legend">* Equal contribution</p></section>
  <section class="home-section"><div class="section-heading"><h2>News</h2><a href="/news/">All news →</a></div><NewsList items={news.slice(0,5)} /></section>
  <section class="home-section"><div class="section-heading"><h2>People</h2><a href="/people/">Meet the lab →</a></div><div class="people-strip">{people.map(person => <PersonCard person={person} compact />)}</div></section>
</Base>
