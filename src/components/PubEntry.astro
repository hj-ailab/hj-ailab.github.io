---
import { people, type Publication } from '../lib/data';
import { bibtex } from '../lib/bibtex';
interface Props { paper: Publication }
const { paper } = Astro.props;
const authors = paper.authors.split(',').map(value => {
  const name = value.trim();
  return {name, member: people.find(person => person.name === name.replace(/\*$/, ''))};
});
---
<article class="publication" id={paper.id} data-publication data-search={`${paper.title} ${paper.authors}`.toLowerCase()} data-topics={paper.topics.join(' ')} data-year={paper.year} data-type={paper.type} data-members={paper.members.join(' ')}>
  <div class="pub-meta"><span>{paper.venue} {paper.year}</span>{paper.note && <span class="award">{paper.note}</span>}</div>
  <div class="pub-body">
    <h3><a class="paper-title" href={paper.paper}>{paper.title}</a></h3>
    <p class="authors">{authors.map(({name, member}, i) => <>{i > 0 && ', '}{member ? <a href={`/people/#${member.id}`}><strong>{name}</strong></a> : name}</>)}</p>
    <div class="tags">{paper.tags.map(tag => <span>{tag}</span>)}</div>
    <div class="pub-links"><a data-paper-link href={paper.paper}>Paper ↗</a>{paper.code && <a data-code-link href={paper.code}>Code ↗</a>}{paper.project && <a data-project-link href={paper.project}>Project ↗</a>}
      <details class="citation"><summary>BibTeX</summary><div class="citation-content"><pre><code>{bibtex(paper)}</code></pre><button type="button" data-copy hidden aria-label={`Copy BibTeX for ${paper.title}`}>Copy BibTeX</button><span class="copy-status" role="status"></span></div></details>
    </div>
  </div>
</article>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const content = button.closest('.citation-content')!;
      const status = content.querySelector('.copy-status')!;
      try {
        await navigator.clipboard.writeText(content.querySelector('code')!.textContent!);
        status.textContent = 'Copied';
      } catch (error) {
        status.textContent = 'Copy unavailable. Select and copy the citation above.';
        console.error('Clipboard copy failed', error);
      }
    });
  });
</script>
